# Copy to .env and fill in. Never commit real values.
#
# Local development: keep DJANGO_DEBUG=true and leave the rest unset (SQLite).
# A random DJANGO_SECRET_KEY is written into .env the first time Django starts.
# Production: anything but DJANGO_DEBUG=true (including unset) is production,
# and Django refuses to start until every "Required in production" value is set.
# Generate each key with: python -c "import secrets; print(secrets.token_urlsafe(64))"

# "true" only on a development machine.
DJANGO_DEBUG=true
# Required in production: 50+ random characters.
DJANGO_SECRET_KEY=
# Required in production: signs login tokens (JWT); 50+ random characters, not the secret key.
DJANGO_JWT_SIGNING_KEY=
# Required in production: comma-separated, e.g. api.example.com.
# With DJANGO_DEBUG=true only localhost and private (LAN) addresses are accepted.
DJANGO_ALLOWED_HOSTS=
# Comma-separated frontend origins, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated origins allowed to POST to the Django admin over HTTPS, e.g. https://api.example.com
CSRF_TRUSTED_ORIGINS=

# HTTPS hardening, applied only when DJANGO_DEBUG=false
DJANGO_SECURE_SSL_REDIRECT=true
# HSTS max-age in seconds; unset means 3600 (one hour). Raise to 31536000 once
# HTTPS works on every host. Never sent in development.
DJANGO_SECURE_HSTS_SECONDS=
# true only if every subdomain is served over HTTPS
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# true only when a trusted reverse proxy terminates TLS and sets X-Forwarded-Proto
DJANGO_BEHIND_TLS_PROXY=false
# Number of trusted reverse proxies that set X-Forwarded-For (0 when clients connect directly)
DJANGO_NUM_PROXIES=0
# Directory collectstatic writes to (default: <project>/staticfiles)
DJANGO_STATIC_ROOT=

# Database. Leave unset for SQLite (development). For MySQL (production) set
# either DATABASE_URL, e.g. mysql://app_user:url-encoded-password@127.0.0.1:3306/my_platform,
# or DB_ENGINE=mysql with the DB_* values below. Requires the mysqlclient package.
DATABASE_URL=
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Shared cache for rate limits across workers (PRODUCTION_SETUP.md section 9),
# e.g. redis://127.0.0.1:6379/1. Unset: each process keeps its own memory cache
# (fine for development; check --deploy warns in production).
REDIS_URL=
# Requests per minute per client IP for each anonymous public endpoint
PUBLIC_API_RATE=60/minute

# The reseller API key is not configured here: generate it in the admin panel
# (API Management -> Regenerate key). Only its hash is stored.

# Show active service rates (INR per 1,000) on the public landing page
PUBLIC_SERVICE_RATES=true

# SMM API v2 provider endpoint (/api/v2) for Perfect Panel
# Requests per minute per client IP
PROVIDER_API_RATE=120/minute
# Refuse plain HTTP (defaults to true when DJANGO_DEBUG=false)
PROVIDER_API_REQUIRE_HTTPS=
# One log line per request (never the key); WARNING silences them
PROVIDER_API_LOG_LEVEL=INFO

# Required in production: 32+ random characters, never the secret key.
# Hashes sign-up/login IP addresses and device IDs; never change it once set.
ACCOUNT_SIGNAL_SALT=
# Secure flag on the device_id cookie (defaults to true when DJANGO_DEBUG=false)
AUTH_COOKIE_SECURE=

# Telegram admin alerts (PRODUCTION_SETUP.md section 13). Nothing is sent unless all three are set.
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
